#!/usr/bin/env bash
set -euo pipefail

G=$'\033[32m'
Y=$'\033[33m'
C=$'\033[36m'
B=$'\033[1m'
D=$'\033[2m'
X=$'\033[0m'

dry_run=false

usage() {
  cat <<EOF
Usage: ggone [-n|--dry-run]

Prune deleted remote-tracking refs, then delete local branches whose
upstream is gone. Worktrees are renamed aside, unregistered, then
deleted in the background. Remote deleted = local deleted. No merge
check.

Skips the currently checked-out branch.

Options:
  -n, --dry-run   List, do not delete
  -h, --help      Show this help

Examples:
  ggone
  ggone -n
  git gone
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n | --dry-run)
      dry_run=true
      shift
      ;;
    -f | --force)
      # Kept for backwards compat; force is now the default.
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "ggone: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "ggone: unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ggone: not a git repository" >&2
  exit 1
fi

git fetch --prune --quiet
git worktree prune --expire now >/dev/null 2>&1 || true

current=$(git branch --show-current 2>/dev/null || true)
current_wt=$(git rev-parse --show-toplevel)

gone_list=''
while IFS=$'\t' read -r branch track worktree; do
  [[ -z "$branch" ]] && continue
  [[ "$track" == '[gone]' ]] || continue
  gone_list+="${branch}"$'\t'"${worktree}"$'\n'
done < <(
  git for-each-ref \
    --format='%(refname:short)%09%(upstream:track)%09%(worktreepath)' \
    refs/heads
)

if [[ -z "$gone_list" ]]; then
  printf '%b%bnothing to clean%b\n' "$B" "$G" "$X"
  exit 0
fi

to_delete=''
deleted_count=0
worktree_count=0

maxlen=0
while IFS=$'\t' read -r branch worktree; do
  [[ -z "$branch" ]] && continue
  n=${#branch}
  if [[ "$n" -gt "$maxlen" ]]; then
    maxlen=$n
  fi
done <<< "$gone_list"

short_path() {
  local path=$1
  if [[ -n "$HOME" && "$path" == "$HOME"/* ]]; then
    printf '~%s' "${path#"$HOME"}"
  else
    printf '%s' "$path"
  fi
}

# git worktree remove deletes every file in-tree (node_modules etc).
# Rename off the registered path first so unregister is metadata-only,
# then unlink in the background so ggone does not wait on disk.
retire_worktree() {
  local path=$1
  local dest

  if [[ ! -e "$path" ]]; then
    git worktree remove --force "$path" >/dev/null 2>&1 || \
      git worktree prune --expire now >/dev/null
    return 0
  fi

  dest="$(dirname "$path")/.ggone-dead-$(basename "$path")-$$-$(date +%s)"

  if mv "$path" "$dest"; then
    git worktree remove --force "$path" >/dev/null 2>&1 || \
      git worktree prune --expire now >/dev/null
    nohup rm -rf "$dest" >/dev/null 2>&1 &
    disown $! 2>/dev/null || true
    return 0
  fi

  git worktree remove --force "$path" >/dev/null
}

while IFS=$'\t' read -r branch worktree; do
  [[ -z "$branch" ]] && continue

  if [[ "$branch" == "$current" ]]; then
    printf '  %b%-*s%b  %bskip%b  (checked out)\n' \
      "$C" "$maxlen" "$branch" "$X" "$D" "$X"
    continue
  fi

  if [[ -n "$worktree" && "$worktree" == "$current_wt" ]]; then
    printf '  %b%-*s%b  %bskip%b  (checked out)\n' \
      "$C" "$maxlen" "$branch" "$X" "$D" "$X"
    continue
  fi

  if [[ -n "$worktree" && -d "$worktree/.git" ]]; then
    printf '  %b%-*s%b  %bskip%b  (main worktree)\n' \
      "$C" "$maxlen" "$branch" "$X" "$D" "$X"
    continue
  fi

  if [[ -n "$worktree" ]]; then
    printf '  %b%-*s%b  %bgone%b  %s\n' \
      "$C" "$maxlen" "$branch" "$X" "$G" "$X" "$(short_path "$worktree")"
    worktree_count=$((worktree_count + 1))
  else
    printf '  %b%-*s%b  %bgone%b\n' \
      "$C" "$maxlen" "$branch" "$X" "$G" "$X"
  fi
  to_delete+="${branch}"$'\t'"${worktree}"$'\n'
done <<< "$gone_list"

to_delete=$(printf '%s' "$to_delete" | sed '/^$/d')

if [[ -n "$to_delete" ]]; then
  deleted_count=$(printf '%s\n' "$to_delete" | wc -l | tr -d ' ')
fi

if [[ -z "$to_delete" ]]; then
  printf '%b%bnothing deleted%b\n' "$B" "$Y" "$X"
  exit 0
fi

printf '\n'

if $dry_run; then
  if [[ "$worktree_count" -gt 0 ]]; then
    printf '%bdry-run%b  would delete %s (%s worktrees)\n' \
      "$Y" "$X" "$deleted_count" "$worktree_count"
  else
    printf '%bdry-run%b  would delete %s\n' "$Y" "$X" "$deleted_count"
  fi
  exit 0
fi

failed=0
removed_wt=0
deleted=0

while IFS=$'\t' read -r branch worktree; do
  [[ -z "$branch" ]] && continue

  if [[ -n "$worktree" ]]; then
    printf '  removing  %s\n' "$(short_path "$worktree")"
    if retire_worktree "$worktree"; then
      removed_wt=$((removed_wt + 1))
    else
      printf '  %b%-*s%b  %bfail%b  worktree %s\n' \
        "$C" "$maxlen" "$branch" "$X" "$Y" "$X" "$(short_path "$worktree")" >&2
      failed=$((failed + 1))
      continue
    fi
  fi

  if git branch -D "$branch" >/dev/null; then
    deleted=$((deleted + 1))
  else
    printf '  %b%-*s%b  %bfail%b\n' \
      "$C" "$maxlen" "$branch" "$X" "$Y" "$X" >&2
    failed=$((failed + 1))
  fi
done <<< "$to_delete"

if [[ "$removed_wt" -gt 0 ]]; then
  printf '%bdeleted %s%b  (%s worktrees)\n' "$G" "$deleted" "$X" "$removed_wt"
else
  printf '%bdeleted %s%b\n' "$G" "$deleted" "$X"
fi

if [[ "$failed" -gt 0 ]]; then
  exit 1
fi
