#!/usr/bin/env bash
set -euo pipefail

G=$'\033[32m'
Y=$'\033[33m'
C=$'\033[36m'
B=$'\033[1m'
D=$'\033[2m'
X=$'\033[0m'

dry_run=false

usage() {
  cat <<EOF
Usage: ggone [-n|--dry-run]

Prune deleted remote-tracking refs, then delete local branches whose
upstream is gone. Remote deleted = local deleted. No merge check.

Skips the currently checked-out branch.

Options:
  -n, --dry-run   List, do not delete
  -h, --help      Show this help

Examples:
  ggone
  ggone -n
  git gone
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n | --dry-run)
      dry_run=true
      shift
      ;;
    -f | --force)
      # Kept for backwards compat; force is now the default.
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "ggone: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "ggone: unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ggone: not a git repository" >&2
  exit 1
fi

git fetch --prune --quiet

gone_list=$(
  git branch -vv \
    | sed 's/^[* ] //' \
    | awk '/: gone]/{print $1}'
)

if [[ -z "$gone_list" ]]; then
  printf '%b%bnothing to clean%b\n' "$B" "$G" "$X"
  exit 0
fi

current=$(git branch --show-current 2>/dev/null || true)
to_delete=''
deleted_count=0

maxlen=0
while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue
  n=${#branch}
  if [[ "$n" -gt "$maxlen" ]]; then
    maxlen=$n
  fi
done <<< "$gone_list"

while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue

  if [[ "$branch" == "$current" ]]; then
    printf '  %b%-*s%b  %bskip%b  (checked out)\n' \
      "$C" "$maxlen" "$branch" "$X" "$D" "$X"
    continue
  fi

  printf '  %b%-*s%b  %bgone%b\n' \
    "$C" "$maxlen" "$branch" "$X" "$G" "$X"
  to_delete="${to_delete}${branch}"$'\n'
done <<< "$gone_list"

to_delete=$(printf '%s' "$to_delete" | sed '/^$/d')

if [[ -n "$to_delete" ]]; then
  deleted_count=$(printf '%s\n' "$to_delete" | wc -l | tr -d ' ')
fi

if [[ -z "$to_delete" ]]; then
  printf '%b%bnothing deleted%b\n' "$B" "$Y" "$X"
  exit 0
fi

printf '\n'

if $dry_run; then
  printf '%bdry-run%b  would delete %s\n' "$Y" "$X" "$deleted_count"
  exit 0
fi

while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue
  git branch -D "$branch" >/dev/null
done <<< "$to_delete"

printf '%bdeleted %s%b\n' "$G" "$deleted_count" "$X"
